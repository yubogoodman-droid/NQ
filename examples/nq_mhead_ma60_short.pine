//@version=5
strategy("M頭右肩破｜跌破MA60做空", overlay=true, pyramiding=0,
     process_orders_on_close=true, calc_on_every_tick=false,
     default_qty_type=strategy.fixed, default_qty_value=1,
     initial_capital=100000, commission_value=0,
     max_labels_count=50)

// 建議警報名稱：M頭右肩破一分k60
// 掛 1 分鐘圖（NQ1! / NQ1! CME 等）。參數預設對齊 examples/nq_m_head.py TF_PRESETS["1m"]。

// === 1m 定稿參數 ===
swingLen     = input.int(7, "轉折確認 K 數", minval=2, group="M頭幾何")
tolPct       = input.float(0.12, "雙頂價差上限 (%)", minval=0.01, step=0.01, group="M頭幾何") / 100.0
h2OverTick   = input.float(0.25, "右肩最多高過左肩（點）", minval=0.0, step=0.25, group="M頭幾何")
minGap       = input.int(20, "雙頂最少間隔", minval=2, group="M頭幾何")
maxGap       = input.int(75, "雙頂最多間隔", minval=10, group="M頭幾何")
minDepthPct  = input.float(0.15, "頸線深度下限 (%)", minval=0.01, step=0.01, group="M頭幾何") / 100.0
hiLookback   = input.int(120, "高檔回看 K 數（約 2 小時）", minval=20, group="高檔")
nearPct      = input.float(0.15, "高峰須接近回看高點 (%)", minval=0.01, step=0.01, group="高檔") / 100.0
minH2Ext     = input.float(30.0, "右肩收盤高於 MA60（點）", minval=0.0, group="高檔")
entryWin     = input.int(35, "確認後進場視窗", minval=1, group="進場")
minBreak     = input.float(8.0, "收盤低於 MA60 至少（點）", minval=0.0, group="進場")
ribbonMin    = input.float(28.0, "MA5/10/20/30/60 帶寬下限", minval=0.0, group="進場")
stopBuf      = input.float(8.0, "停損 = 頭頂 +", minval=0.0, group="出場")
minRisk      = input.float(50.0, "最小風險（點）", minval=1.0, group="出場")
maxRisk      = input.float(220.0, "最大風險（點）", minval=10.0, group="出場")
targetR      = input.float(2.0, "停利 R", minval=0.5, step=0.1, group="出場")
holdBars     = input.int(120, "最長持倉 K 數", minval=2, group="出場")
trailArmR    = input.float(1.6, "鎖利啟動 R", minval=0.1, step=0.1, group="出場")
trailLockR   = input.float(1.2, "鎖利保留 R", minval=0.1, step=0.1, group="出場")
tickSize     = input.float(0.25, "最小跳動", minval=0.01, group="出場")

roundTick(p) =>
    math.round(p / tickSize) * tickSize

sma5  = ta.sma(close, 5)
sma10 = ta.sma(close, 10)
sma20 = ta.sma(close, 20)
sma30 = ta.sma(close, 30)
sma60 = ta.sma(close, 60)

ribbonSpread() =>
    mx = math.max(sma5, math.max(sma10, math.max(sma20, math.max(sma30, sma60))))
    mn = math.min(sma5, math.min(sma10, math.min(sma20, math.min(sma30, sma60))))
    mx - mn

ph = ta.pivothigh(high, swingLen, swingLen)

var array<float> phPx = array.new_float()
var array<int>   phBar = array.new_int()

var bool  armed = false
var float h1Px = na
var float h2Px = na
var float neckPx = na
var float peakPx = na
var int   confirmBar = na
var int   h2BarStored = na

var float origStop = na
var float trailStop = na
var float pendingLock = na
var float entryPx = na
var float riskPx = na
var float tgtPx = na
var int   entryBar = na

// 新確認的擺動高：與較早的擺動高配對，取該右肩深度最大的經典 M（右肩不得再創高）
if not na(ph)
    h2p = ph
    h2b = bar_index - swingLen
    bestDepth = 0.0
    float bestH1 = na
    float bestH2 = na
    float bestNeck = na
    float bestPeak = na
    int   nPh = array.size(phBar)
    if nPh > 0
        for i = 0 to nPh - 1
            h1p = array.get(phPx, i)
            h1b = array.get(phBar, i)
            gap = h2b - h1b
            if gap >= minGap and gap <= maxGap
                avgH = (h1p + h2p) / 2.0
                if avgH > 0 and h2p <= h1p + h2OverTick and (h1p - h2p) / avgH <= tolPct
                    nLen = h2b - h1b - 1
                    if nLen >= 1
                        off = bar_index - (h2b - 1)
                        neck = ta.lowest(low, nLen)[off]
                        peak = math.max(h1p, h2p)
                        depth = peak - neck
                        if peak > 0 and depth / peak >= minDepthPct and depth >= bestDepth
                            // 高檔：兩峰與頸線當時仍在 MA60 上；右肩收盤高於 MA60
                            h1Ma = sma60[bar_index - h1b]
                            h2Ma = sma60[bar_index - h2b]
                            // 頸線那根的 MA60（用頸線 K 的收盤近似對齊 Python 的 sma(close)）
                            neckOff = bar_index - (h2b - nLen)
                            neckMa = sma60[math.max(0, neckOff)]
                            h2Close = close[bar_index - h2b]
                            winHi = ta.highest(high[swingLen], hiLookback)
                            highOk = not na(h1Ma) and not na(h2Ma) and not na(neckMa) and not na(h2Close) and not na(winHi)
                            highOk := highOk and h1p >= h1Ma and h2p >= h2Ma and h2Close >= h2Ma and neck >= neckMa
                            highOk := highOk and (h2Close - h2Ma >= minH2Ext)
                            highOk := highOk and peak >= winHi * (1.0 - nearPct)
                            if highOk
                                bestDepth := depth
                                bestH1 := h1p
                                bestH2 := h2p
                                bestNeck := neck
                                bestPeak := peak
    array.push(phPx, h2p)
    array.push(phBar, h2b)
    if array.size(phBar) > 24
        array.shift(phPx)
        array.shift(phBar)
    if not na(bestH1) and strategy.position_size == 0
        armed := true
        h1Px := bestH1
        h2Px := bestH2
        neckPx := bestNeck
        peakPx := bestPeak
        confirmBar := bar_index
        h2BarStored := h2b

// 等待收盤同時跌破頸線與 MA60（至少 minBreak 點），帶寬打開才進
shortNow = false
if armed and strategy.position_size == 0
    if high > peakPx
        armed := false
    else if bar_index > confirmBar + entryWin
        armed := false
    else if not na(sma5) and not na(sma10) and not na(sma20) and not na(sma30) and not na(sma60)
        underMa = close <= sma60 - minBreak
        underNeck = close < neckPx
        ribbonOk = ribbonSpread() >= ribbonMin
        if underMa and underNeck and ribbonOk
            stopCand = roundTick(peakPx + stopBuf)
            ent = roundTick(close)
            risk = stopCand - ent
            tgt = roundTick(ent - risk * targetR)
            if risk >= minRisk and risk <= maxRisk and tgt < ent
                shortNow := true
                origStop := stopCand
                trailStop := stopCand
                pendingLock := na
                entryPx := ent
                riskPx := risk
                tgtPx := tgt
                entryBar := bar_index
                strategy.entry("M頭空", strategy.short)
                strategy.exit("M頭出場", from_entry="M頭空", stop=stopCand, limit=tgt)
                alert("M頭右肩破一分k60 做空 @ " + str.tostring(ent) + " 停損 " + str.tostring(stopCand) + " 目標 " + str.tostring(tgt), alert.freq_once_per_bar_close)
                armed := false

// 鎖利：見過 1.6R 後，下一根才把停損收到 1.2R（做空：價越低鎖越多）
if strategy.position_size < 0
    if not na(pendingLock)
        trailStop := math.min(trailStop, pendingLock)
        pendingLock := na
        strategy.exit("M頭出場", from_entry="M頭空", stop=trailStop, limit=tgtPx)
    if high >= origStop
        strategy.exit("M頭出場", from_entry="M頭空", stop=origStop, limit=tgtPx)
    else
        mfe = entryPx - low
        if riskPx > 0 and mfe / riskPx >= trailArmR
            pendingLock := roundTick(entryPx - trailLockR * riskPx)
    if bar_index - entryBar >= holdBars
        strategy.close("M頭空", comment="time_stop")
        alert("M頭右肩破一分k60 逾時平倉 @ " + str.tostring(close), alert.freq_once_per_bar_close)

plot(sma60, "MA60", color=color.new(color.aqua, 20), linewidth=2)
plot(armed ? neckPx : na, "頸線", color=color.orange, linewidth=2, style=plot.style_linebr)
plot(armed ? peakPx : na, "頭頂", color=color.red, linewidth=1, style=plot.style_linebr)
plotshape(shortNow, title="做空", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)
bgcolor(armed ? color.new(color.orange, 92) : na)

alertcondition(shortNow, title="M頭右肩破一分k60", message="M頭右肩破一分k60 做空")

// ---------------------------------------------------------------------------
// 規則（對齊 examples/nq_m_head.py 1m 定稿，非 5m）
// - 經典 M：左峰為頭，右峰 ≤ 左峰 + 0.25；雙頂價差 ≤ 0.12%；間隔 20–75 根
// - 頸線 = 兩峰之間最低價；深度 ≥ 0.15%
// - 高檔：兩峰與頸線在當時 MA60 之上；右肩收盤至少高於 MA60 30 點；高峰接近近 120 根高點
// - 右肩再確認 7 根後，35 根內：收盤 < 頸線 且 收盤 ≤ MA60−8，且 MA5/10/20/30/60 帶寬 ≥ 28
// - 停損頭頂 +8；風險 50–220；目標 2R；最多持 120 根；1.6R 鎖 1.2R（下一根）
// - 1m 沒有 5m 的 MA120/200 夾心、遠 MA200、1h 未測過濾
//
// 與 Python 的差異（TV 無法 100% 重現）：
// 1) 擺動高用 ta.pivothigh 左右各 7 根，只保留最近約 24 個樞軸再配對；Python 全歷史兩兩掃描後依右肩去重取最深 M。
// 2) 頸線那根的 MA60 用「距右肩的偏移」近似，不是 Python 在頸線 index 上的精確 sma。
// 3) 成交與停損觸發受 TradingView 引擎／商品合約影響；Python 回測是 Yahoo NQ=F、fill=close、無費。
// 4) 不重疊：TV pyramiding=0；Python 是持倉結束前不接下一筆。
// 非投資建議。
// ---------------------------------------------------------------------------
