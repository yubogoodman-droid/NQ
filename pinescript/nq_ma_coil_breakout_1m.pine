//@version=5
indicator("NQ 一分K 起漲點（均線糾結突破）", overlay=true, max_labels_count=200)

// 訊號在 1 分圖上抓。5 分用來對照進場當下那根 5 分長什麼樣。
// 先鎖住盤整箱，再允許之後 8 根放量站上箱頂。
// 進場：第一次站上 MA200，且 5>10>20>30、MA60/120 在 MA200 下方。不要等放量長綠。

minCoilBars   = input.int(10, "盤整最少 K 數", minval=8, maxval=20)
maxCoilBars   = input.int(18, "盤整最多 K 數", minval=10, maxval=30)
maxCoilRange  = input.float(36.0, "盤整最大區間（點）", minval=10, step=2)
minCoilRange  = input.float(10.0, "盤整最小區間（點）", minval=0, step=1)
maxRibbon     = input.float(42.0, "均線最大帶寬（點）", minval=10, step=2)
minBody       = input.float(0.0, "突破 K 最小實體（點）", minval=0, step=1)
volMult       = input.float(2.0, "量能倍數（對成交量中位數）", minval=1.0, step=0.1)
minPriorDrop  = input.float(30.0, "盤整前最少回檔（點）", minval=0, step=5)
priorLookback = input.int(120, "回檔回看 K 數", minval=30)
minBreakOver  = input.float(1.0, "收盤高出盤整高點（點）", minval=0, step=0.5)
maxMa200Drop  = input.float(25.0, "MA200 最多下跌（20根）", minval=0, step=5)
breakWindow   = input.int(8, "盤整後允許多少根突破", minval=1, maxval=20)
stopBuffer    = input.float(5.0, "停損低於盤整低點（點）", minval=0, step=1)
targetPts     = input.float(50.0, "固定停利（點）", minval=1, step=5)

ma5   = ta.sma(close, 5)
ma10  = ta.sma(close, 10)
ma20  = ta.sma(close, 20)
ma30  = ta.sma(close, 30)
ma60  = ta.sma(close, 60)
ma100 = ta.sma(close, 100)
ma120 = ta.sma(close, 120)
ma200 = ta.sma(close, 200)

ribbon = array.from(ma5, ma10, ma20, ma30, ma60, ma100, ma120, ma200)
ribbonHigh = array.max(ribbon)
ribbonLow  = array.min(ribbon)
ribbonWidth = ribbonHigh - ribbonLow

volMed = ta.percentile_nearest_rank(volume, 60, 50)
priorHigh = ta.highest(high, priorLookback + maxCoilBars)
priorLow  = ta.lowest(low, priorLookback + maxCoilBars)
priorDrop = priorHigh - priorLow
ma200Flat = na(ma200[20]) or (ma200[1] - ma200[21]) >= -maxMa200Drop
body = close - open

bestRange = 1e10
float bestHigh = na
float bestLow = na
int bestLen = 0
for len = minCoilBars to maxCoilBars
    ch = ta.highest(high[1], len)
    cl = ta.lowest(low[1], len)
    rng = ch - cl
    preHi = ta.highest(high[len], priorLookback)
    preLo = ta.lowest(low[len], priorLookback)
    preRange = preHi - preLo
    squeezeOk = na(preRange) or preRange <= 0 or rng <= preRange * 0.70
    if rng >= minCoilRange and rng <= maxCoilRange and ribbonWidth[1] <= maxRibbon and squeezeOk and rng < bestRange
        bestRange := rng
        bestHigh := ch
        bestLow := cl
        bestLen := len

wasCoil = not na(bestHigh) and ma200Flat and priorDrop >= minPriorDrop

var float stickyHigh = na
var float stickyLow = na
var int stickyBar = na

if wasCoil and (na(stickyHigh) or close <= stickyHigh)
    stickyHigh := bestHigh
    stickyLow := bestLow
    stickyBar := bar_index - 1

if not na(stickyBar) and bar_index - stickyBar > breakWindow
    stickyHigh := na
    stickyLow := na
    stickyBar := na

volOk = na(volMed) or volMed <= 0 or volume >= volMed * volMult
stackOk = ma5 > ma10 and ma10 > ma20 and ma20 > ma30
above200 = close > ma200
longBelow = ma60 < ma200 and ma120 < ma200
breakout = not na(stickyHigh) and body >= minBody and close >= stickyHigh + minBreakOver and stackOk and above200 and longBelow and volOk

plot(ma5,   "MA5",   color=#ffa726, linewidth=1)
plot(ma10,  "MA10",  color=#42a5f5, linewidth=1)
plot(ma20,  "MA20",  color=#ec407a, linewidth=1)
plot(ma30,  "MA30",  color=#26c6da, linewidth=1)
plot(ma60,  "MA60",  color=#66bb6a, linewidth=1)
plot(ma100, "MA100", color=#ffeb3b, linewidth=1)
plot(ma120, "MA120", color=#ef5350, linewidth=1)
plot(ma200, "MA200", color=#26a69a, linewidth=1)

plotshape(breakout, title="起漲點", style=shape.triangleup, location=location.belowbar, color=color.new(#00e676, 0), size=size.small, text="起漲")

var float stopLevel = na
var float tgtLevel  = na
if breakout
    stopLevel := stickyLow - stopBuffer
    tgtLevel := close + targetPts
    stickyHigh := na
    stickyLow := na
    stickyBar := na

plot(breakout ? stopLevel : na, "停損", color=color.red, style=plot.style_circles, linewidth=2)
plot(breakout ? tgtLevel : na, "目標", color=color.lime, style=plot.style_circles, linewidth=2)

bgcolor(not na(stickyHigh) and not breakout ? color.new(#ffeb3b, 92) : na, title="糾結盤整")

alertcondition(breakout, title="NQ 起漲點", message="NQ 均線糾結突破（起漲點）")
