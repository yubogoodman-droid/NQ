//@version=5
indicator("15m MA5/20/99 多頭排列 · 剛站上 MA200", overlay=true)

// MA5 > MA20 > MA99，這根才剛收盤站上 200。
// 均線距離對齊 ETH 圖：整排 ≤ 0.8%，99 與 200 ≤ 0.7%。

maxRibbonPct = input.float(0.8, "均線寬度上限 %", minval=0.2, step=0.1)
maxGap99Pct  = input.float(0.7, "MA99 與 MA200 距離上限 %", minval=0.1, step=0.1)
maxExtPct    = input.float(1.0, "收盤離 200 上限 %", minval=0.2, step=0.1)

ma5   = ta.sma(close, 5)
ma20  = ta.sma(close, 20)
ma99  = ta.sma(close, 99)
ma200 = ta.sma(close, 200)

stacked = ma5 > ma20 and ma20 > ma99
above   = close > ma200
justOn  = above and not (close[1] > ma200[1])
ribbonLo = math.min(ma5, math.min(ma20, math.min(ma99, ma200)))
ribbonHi = math.max(ma5, math.max(ma20, math.max(ma99, ma200)))
ribbon   = ribbonLo > 0 ? ribbonHi / ribbonLo - 1.0 : 99.0
gap99    = ma200 > 0 ? math.abs(ma99 / ma200 - 1.0) : 99.0
ext      = ma200 > 0 ? close / ma200 - 1.0 : 99.0
compact  = ribbon <= maxRibbonPct / 100.0 and gap99 <= maxGap99Pct / 100.0 and ext >= 0 and ext <= maxExtPct / 100.0
first    = stacked and justOn and compact

plot(ma5,   "MA5",   color=color.new(#f0c14a, 0), linewidth=1)
plot(ma20,  "MA20",  color=color.new(#64b5f6, 0), linewidth=1)
plot(ma99,  "MA99",  color=color.new(#7e57c2, 0), linewidth=2)
plot(ma200, "MA200", color=color.new(#ef5350, 0), linewidth=2)

plotshape(first, title="剛站上200", style=shape.triangleup, location=location.belowbar, color=color.new(#3dba7a, 0), size=size.small)
bgcolor(stacked and compact and above and not first ? color.new(#3dba7a, 94) : na, title="已站上且均線仍黏")

alertcondition(first, title="15m 多頭排列 · 剛站上 MA200", message="MA5>MA20>MA99，均線黏著，這根剛站上 MA200")
