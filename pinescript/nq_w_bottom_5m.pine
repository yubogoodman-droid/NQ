//@version=5
strategy("NQ 五分K 破底W底進場", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000, process_orders_on_close=true)

// L1 左、L2 破底、L3 右；L3 收盤當下進場（不看後面的 K）
swingLen      = input.int(3, "轉折確認 K 數", minval=1)
tolPct        = input.float(0.1, "L1/L3 價差容忍 (%)", minval=0.05, step=0.05) / 100
minSpringPct  = input.float(0.10, "L2 低於 L1 最少 (%)", minval=0.05, step=0.01) / 100
minSpringPts  = input.float(25.0, "L2 低於 L1 最少點數", minval=0, step=1)
minBouncePct  = input.float(0.10, "破底前最少反彈 (%)", minval=0.05, step=0.01) / 100
minBars       = input.int(8, "L1 到 L3 最少間隔", minval=4)
maxBars       = input.int(24, "L1 到 L3 最多間隔（2小時）", minval=10)
stopPts       = input.float(20.0, "停損在 L3 下方點數", minval=0, step=1)

pl = ta.pivotlow(low, swingLen, swingLen)

var float l1         = na
var int   l1Bar      = na
var float l2         = na
var float l3         = na
var int   l3Bar      = na
var float neckline   = na
var bool  wReady     = false

reset() =>
    l1         := na
    l1Bar      := na
    l2         := na
    l3         := na
    l3Bar      := na
    neckline   := na
    wReady     := false

if not na(pl) and na(l1)
    l1    := pl
    l1Bar := bar_index - swingLen

// L3 用當根收盤判定：只看左側，不要求後面幾根守住
if not na(l1) and na(l3)
    gap = bar_index - l1Bar
    if gap >= minBars and gap <= maxBars
        avgLow = (l1 + low) / 2.0
        priceOk = avgLow > 0 and math.abs(l1 - low) / avgLow <= tolPct
        midLow = ta.lowest(low[1], gap - 1)
        neck = ta.highest(high[1], gap - 1)
        reclaimed = ta.highest(close[1], gap - 1) > l1
        springOk = l1 - midLow >= math.max(l1 * minSpringPct, minSpringPts)
        bounceOk = neck - math.max(l1, low) >= l1 * minBouncePct
        l2Gap = ta.barssince(low[1] == midLow) + 1
        win = math.min(swingLen + 1, l2Gap)
        leftLow = win >= 2 and low == ta.lowest(low, win)
        if priceOk and leftLow and low > midLow and springOk and bounceOk and reclaimed
            l2       := midLow
            l3       := low
            l3Bar    := bar_index
            neckline := neck
            wReady   := true

longSignal = wReady and not na(l3)

if longSignal
    strategy.entry("破底W做多", strategy.long)
    strategy.exit("破底W出場", "破底W做多", stop=l3 - stopPts, limit=neckline + (neckline - l2))
    reset()

plotshape(longSignal, title="破底W進場", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small)
plot(not na(neckline) ? neckline : na, "頸線", color=color.orange, linewidth=2, style=plot.style_linebr)
plot(not na(l1) ? l1 : na, "L1", color=color.aqua, linewidth=1, style=plot.style_circles)
plot(not na(l2) ? l2 : na, "L2破底", color=color.fuchsia, linewidth=1, style=plot.style_circles)
plot(not na(l3) ? l3 : na, "L3", color=color.red, linewidth=1, style=plot.style_circles)
