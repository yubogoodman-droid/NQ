//@version=5
strategy("1分K 5/10/20多頭且站上MA200", overlay=true, process_orders_on_close=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

rewardR = input.float(2.0, "停利 R 倍數", minval=0.5, step=0.5)
skipOpen = input.int(5, "略過開盤分鐘", minval=0)

ma5   = ta.sma(close, 5)
ma10  = ta.sma(close, 10)
ma20  = ta.sma(close, 20)
ma200 = ta.sma(close, 200)

stacked = ma5 > ma10 and ma10 > ma20
above200 = close > ma200
newDay = ta.change(time("D")) != 0
barsToday = nz(ta.barssince(newDay), 0)
openOk = barsToday >= skipOpen
notify = stacked and above200 and not above200[1] and openOk

if notify
    stopLevel = ma20
    risk = close - stopLevel
    if risk > 0
        strategy.entry("多頭排列", strategy.long)
        strategy.exit("多頭排列出場", "多頭排列", stop=stopLevel, limit=close + rewardR * risk)

alertcondition(notify, title="1分K 收盤站上MA200（多頭排列）", message="{{ticker}} 1分K 收盤剛站上 MA200，且 MA5>MA10>MA20")
if notify
    alert("{{ticker}} 1分K 收盤剛站上 MA200，且 MA5>MA10>MA20", alert.freq_once_per_bar_close)

plot(ma5, "MA5", color=color.new(#ffa726, 0), linewidth=2)
plot(ma10, "MA10", color=color.new(#ffeb3b, 0), linewidth=2)
plot(ma20, "MA20", color=color.new(#66bb6a, 0), linewidth=2)
plot(ma200, "MA200", color=color.new(#ab47bc, 0), linewidth=3)
plotshape(notify, title="通知", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small)
