//@version=5
strategy("NQ 破2h低 掛單MA60五分鐘", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000, pyramiding=0)

// === 參數 ===
twoHourBars   = input.int(120, "兩小時視窗（1m）", minval=30)
setupWindow   = input.int(30, "破底後有效分鐘", minval=5)
limitBars     = input.int(5, "掛單有效分鐘", minval=1)
minDepth      = input.float(10.0, "最少破底深度（點）", minval=0)
targetR       = input.float(2.0, "目標 R", minval=0.5, step=0.5)

ma5  = ta.sma(close, 5)
ma20 = ta.sma(close, 20)
ma60 = ta.sma(close, 60)
twoHrLow = ta.lowest(low, twoHourBars)[1]

var int   breakBar   = na
var float breakLow   = na
var int   setupBar   = na
var float limitPx    = na
var float stopPx     = na
var float targetPx   = na
var bool  orderLive  = false

brokeNow = not na(twoHrLow) and low < twoHrLow and (twoHrLow - low) >= minDepth

if brokeNow
    breakBar := bar_index
    breakLow := low
    setupBar := na
    limitPx  := na
    orderLive := false
    strategy.cancel("MA60限價")

inWindow = not na(breakBar) and bar_index > breakBar and bar_index <= breakBar + setupWindow
bullStack = ma5 > ma20
crossedMa60 = ta.crossover(close, ma60)
setupNow = inWindow and bullStack and crossedMa60 and not orderLive and na(setupBar)

if setupNow
    setupBar := bar_index
    limitPx  := ma60
    stopPx   := breakLow
    risk     = limitPx - stopPx
    targetPx := risk > 0 ? limitPx + risk * targetR : na
    if risk > 0
        strategy.order("MA60限價", strategy.long, limit=limitPx)
        orderLive := true

if orderLive and not na(setupBar) and bar_index > setupBar + limitBars and strategy.position_size == 0
    strategy.cancel("MA60限價")
    orderLive := false
    setupBar := na
    limitPx  := na

if strategy.position_size > 0 and orderLive
    orderLive := false
    strategy.exit("MA60出場", "MA60限價", stop=stopPx, limit=targetPx)

if not na(breakBar) and bar_index > breakBar + setupWindow and strategy.position_size == 0
    if orderLive
        strategy.cancel("MA60限價")
    orderLive := false
    breakBar := na
    setupBar := na

plot(ma5, "MA5", color=color.new(color.orange, 0), linewidth=1)
plot(ma20, "MA20", color=color.new(color.green, 0), linewidth=1)
plot(ma60, "MA60", color=color.new(color.aqua, 0), linewidth=2)
plot(twoHrLow, "2h低", color=color.new(color.gray, 30), style=plot.style_linebr)

plotshape(brokeNow, title="破2h低", style=shape.triangledown, location=location.abovebar, color=color.fuchsia, size=size.tiny)
plotshape(setupNow, title="破MA60掛單", style=shape.diamond, location=location.belowbar, color=color.aqua, size=size.small)
plot(orderLive and not na(limitPx) ? limitPx : na, "掛單價", color=color.aqua, style=plot.style_circles, linewidth=2)
