//@version=5
strategy("SOXS 15分 起跌", overlay=true, pyramiding=0, process_orders_on_close=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=10000)

// 15 分收盤同時跌破頸線、收在 MA25 下、量能回到均量，才是起跌。
// 極點（例如 54.85）只用來確認高點不再創新高，不當進場，也不當停損。
// 停損放在較低高點。量能不夠則只接一次 MA7–MA25 回測失敗。

if timeframe.period != "15"
    runtime.error("起跌策略只跑在 15 分圖")

swingLen   = input.int(2, "轉折確認 K 數", minval=1)
maFastLen  = input.int(7, "MA 快", minval=1)
maSlowLen  = input.int(25, "MA 慢", minval=1)
volLen     = input.int(10, "量能均線", minval=1)
minPullPct = input.float(0.8, "回檔至少 (%)", minval=0.1, step=0.1) / 100
minGapPct  = input.float(0.1, "較低高點至少低於極點 (%)", minval=0.0, step=0.1) / 100
minBounce  = input.float(0.3, "反彈至少離開頸線 (%)", minval=0.0, step=0.1) / 100
maxSpan    = input.int(24, "極點到較低高點最多幾根", minval=3, maxval=80)
maxBars    = input.int(10, "較低高點後最多等幾根", minval=1)
maxExtPct  = input.float(0.8, "離開頸線超過 (%) 就不追", minval=0.1, step=0.1) / 100
retestBars = input.int(6, "回測最多等幾根", minval=1)
rewardR    = input.float(1.5, "停利 R 倍", minval=0.5, step=0.1)
riskUsdt   = input.float(100, "單筆可虧 USDT", minval=1)
holdBars   = input.int(16, "最多持有 K 數", minval=1)

maFast = ta.sma(close, maFastLen)
maSlow = ta.sma(close, maSlowLen)
volMa  = ta.sma(volume, volLen)[1]
ph     = ta.pivothigh(high, swingLen, swingLen)

var float extremePx = na
var int   extremeBar = na
var float lowerPx = na
var int   lowerBar = na
var float neck = na
var int   phase = 0   // 0 尋找, 1 等跌破, 2 等回測, 3 冷卻
var int   coolUntil = -1
var int   retestLeft = 0
var float bounceHigh = na
var int   entryBar = na
var lows = array.new_float()

array.push(lows, low)
if array.size(lows) > 400
    array.shift(lows)

if not na(ph)
    int pivotBar = bar_index - swingLen
    bool fresh = phase == 3 and pivotBar > coolUntil
    if fresh or na(extremePx) or ph >= extremePx
        extremePx := ph
        extremeBar := pivotBar
        lowerPx := na
        lowerBar := na
        neck := na
        phase := 0
    else if (phase == 0 or phase == 1) and pivotBar > extremeBar and ph < extremePx * (1 - minGapPct) and (na(lowerPx) or ph > lowerPx)
        int span = pivotBar - extremeBar - 1
        float lo = na
        int size = array.size(lows)
        int newest = size - 1 - (swingLen + 1)
        int oldest = newest - (span - 1)
        if span >= 1 and span <= maxSpan and oldest >= 0 and newest < size
            lo := array.get(lows, oldest)
            if newest > oldest
                for j = oldest + 1 to newest
                    lo := math.min(lo, array.get(lows, j))
        bool deep = not na(lo) and (extremePx - lo) / extremePx >= minPullPct
        bool bounced = not na(lo) and low[swingLen] >= lo and ph > lo * (1 + minBounce)
        if deep and bounced
            lowerPx := ph
            lowerBar := pivotBar
            neck := lo
            phase := 1

bool breakSignal = false
bool retestSignal = false
bool armRetest = false
float stopPrice = na

if phase == 1 and not na(lowerBar)
    if bar_index - lowerBar > maxBars or high >= extremePx or close > extremePx
        phase := 0
        extremePx := na
        lowerPx := na
        neck := na
    else if close < neck
        float extension = (neck - close) / neck
        if extension > maxExtPct
            phase := 0
            extremePx := na
            lowerPx := na
            neck := na
        else if close < maSlow and volume >= volMa
            breakSignal := true
            stopPrice := lowerPx
            phase := 3
            coolUntil := bar_index
        else if close < maSlow
            armRetest := true
            phase := 2
            retestLeft := retestBars
            bounceHigh := high

// 量能不夠的那根只負責掛上回測，不當回測進場。
if phase == 2 and not armRetest
    bounceHigh := math.max(nz(bounceHigh, high), high)
    retestLeft -= 1
    bool failed = retestLeft < 0 or high >= extremePx or close > extremePx or bounceHigh >= lowerPx
    if failed
        phase := 0
        extremePx := na
        lowerPx := na
        neck := na
    else
        float bandLo = math.min(maFast, maSlow)
        float bandHi = math.max(maFast, maSlow)
        bool tagged = high >= bandLo and low <= bandHi
        bool backUnder = close < bandLo and close < neck
        float extend = (bandLo - close) / bandLo
        if tagged and backUnder and extend >= 0 and extend <= maxExtPct
            retestSignal := true
            stopPrice := bounceHigh
            phase := 3
            coolUntil := bar_index

bool enter = (breakSignal or retestSignal) and not na(stopPrice) and stopPrice > close
float risk = enter ? stopPrice - close : na
int qty = enter ? int(math.floor(riskUsdt / risk)) : 0
float target = enter ? close - rewardR * risk : na

if enter and qty > 0
    entryBar := bar_index
    strategy.entry("起跌", strategy.short, qty=qty)
    strategy.exit("出場", from_entry="起跌", stop=stopPrice, limit=target, comment_loss="停損", comment_profit="停利")

if strategy.position_size < 0 and not na(entryBar) and bar_index - entryBar >= holdBars
    strategy.close("起跌", comment="時間到")

plot(maFast, "MA7", color=color.new(color.teal, 0), linewidth=1)
plot(maSlow, "MA25", color=color.new(color.orange, 0), linewidth=1)
plot(phase == 1 or phase == 2 ? neck : na, "頸線", color=color.new(color.red, 0), style=plot.style_linebr, linewidth=2)
plot(not na(lowerPx) and (phase == 1 or phase == 2) ? lowerPx : na, "較低高點", color=color.new(color.yellow, 0), style=plot.style_linebr)
plotshape(breakSignal, title="起跌", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="起跌")
plotshape(retestSignal, title="回測", style=shape.triangledown, location=location.abovebar, color=color.orange, size=size.tiny, text="回測")
