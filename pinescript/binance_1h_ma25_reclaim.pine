//@version=5
indicator("1h MA25 下破底再站上", overlay=true, max_labels_count=50)

// 預設寬鬆：跌破 MA25 至少 4 根、深度 1.8%，再站回。
// 勾「截圖急殺」才加上 4 根急殺 / ATR / 破前低。
// 筆畫那種 W（先一腳、吻 MA25、再破底）以 Python 嚴格版為準。
maLen        = input.int(25, "均線", minval=5)
minBelow     = input.int(4, "在均線下至少幾根", minval=2)
maxBelow     = input.int(36, "在均線下最多幾根", minval=6)
minDepthPct  = input.float(1.8, "相對 MA25 最低深度 %", minval=0.3, step=0.1) / 100
useFlush     = input.bool(false, "截圖急殺（嚴）")
minImpulse   = input.float(2.3, "4 根急殺 %", minval=0.5, step=0.1) / 100
minUndercut  = input.float(1.4, "破前低 %", minval=0.3, step=0.1) / 100
minAtrMult   = input.float(2.8, "急殺 ATR 倍數", minval=1.0, step=0.1)

ma7   = ta.sma(close, 7)
ma14  = ta.sma(close, 14)
ma25  = ta.sma(close, maLen)
ma99  = ta.sma(close, 99)
ma120 = ta.sma(close, 120)
ma200 = ta.sma(close, 200)
plot(ma7, "MA7", color=color.new(#f0b90b, 0), linewidth=1)
plot(ma14, "MA14", color=color.new(#4dd0e1, 0), linewidth=1)
plot(ma25, "MA25", color=color.new(#d28cff, 0), linewidth=2)
plot(ma99, "MA99", color=color.new(#7e57c2, 0), linewidth=1)
plot(ma120, "MA120", color=color.new(#66bb6a, 0), linewidth=1)
plot(ma200, "MA200", color=color.new(#c62828, 0), linewidth=1)

below = close < ma25
barsBelow = 0
for i = 0 to maxBelow
    if below[i]
        barsBelow += 1
    else
        break

crossedUp = close > ma25 and close[1] <= ma25[1]
episodeLow = ta.lowest(low, math.max(barsBelow, 1))
depthOk = ma25 > 0 and (ma25 - episodeLow) / ma25 >= minDepthPct
barsOk = barsBelow >= minBelow and barsBelow <= maxBelow

flushHigh = ta.highest(high, 4)
flushLow  = ta.lowest(low, 4)
impulse   = flushHigh > 0 ? (flushHigh - flushLow) / flushHigh : 0
atrVal    = ta.atr(14)
flushAtr  = atrVal > 0 ? (flushHigh - flushLow) / atrVal : 0
priorLow  = ta.lowest(low[4], 12)
undercut  = priorLow > 0 ? (priorLow - flushLow) / priorLow : 0
flushOk   = not useFlush or (impulse >= minImpulse and flushAtr >= minAtrMult and undercut >= minUndercut)

reclaim = crossedUp and barsOk and depthOk and flushOk

plotshape(reclaim, title="站上 MA25", style=shape.triangleup, location=location.belowbar, color=color.new(#00e676, 0), size=size.small)
bgcolor(below and barsBelow >= minBelow ? color.new(#d28cff, 92) : na)

alertcondition(reclaim, title="1h MA25 重新站上", message="1h 已從 MA25 下方破底後重新站上")
