# Copy to copier.env (gitignored). Create the API key in Tradovate:
# Application Settings → API Access (full trading permissions, not read-only).
#
# Demo and live are different logins / hosts. Start with demo.

TRADOVATE_NAME=
TRADOVATE_PASSWORD=
TRADOVATE_CID=
TRADOVATE_SEC=
# Optional. A stable UUID is also stored in copier.device_id (needed for live).
# TRADOVATE_DEVICE_ID=

# Second login (only if followers are on another username):
# TRADOVATE_FIRM2_NAME=
# TRADOVATE_FIRM2_PASSWORD=
# TRADOVATE_FIRM2_CID=
# TRADOVATE_FIRM2_SEC=
